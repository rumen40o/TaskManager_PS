<Window x:Class="TaskManager.View.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Register"
        Height="350"
        Width="350"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Register" FontSize="24" Margin="0,0,0,20"/>

            <TextBlock Text="Username"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

            <TextBlock Text="Email"/>
            <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,10"/>

            <TextBlock Text="Password"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,5,0,15"/>

            <Button Content="Register" Command="{Binding RegisterCommand}" Height="30" Margin="0,0,0,10"/>
            <Button Content="Back to Login" Command="{Binding BackToLoginCommand}" Height="30"/>
        </StackPanel>
    </Grid>
</Window>